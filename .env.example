# Copy to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit real values.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (or publishable) key. Safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the app, used in auth emails (optional locally, set in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: max sign-in/sign-up attempts per IP per minute (default 10)
# AUTH_RATE_LIMIT_MAX=10
# Optional: max password-reset requests per IP per 15 minutes (default 5)
# PASSWORD_RESET_RATE_LIMIT_MAX=5

# Optional: the public feedback widget files GitHub issues (and adds them to a project board).
# Issues in a public repo are public, so the widget collects no personal details.
# Token: classic PAT with `repo` and `project` scopes (fine-grained tokens can't write to user-owned projects).
# Without GITHUB_PROJECT_*, issues are still created. Without GITHUB_TOKEN/GITHUB_REPO, the widget reports it is unavailable.
# GITHUB_TOKEN=
# GITHUB_REPO=prabhu-cg/Yedara
# GITHUB_PROJECT_OWNER=prabhu-cg
# GITHUB_PROJECT_NUMBER=8
